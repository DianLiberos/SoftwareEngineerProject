generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  WALLET
  BANK_CARD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum IngredientUnit {
  GRAM
  MILLILITER
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  password      String
  role          Role               @default(CUSTOMER)
  name          String
  loyaltyPoints Int                @default(0)
  orders        Order[]
  redemptions   CouponRedemption[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Product {
  id         String           @id @default(cuid())
  name       String
  price      Int
  sizes      ProductSize[]
  toppings   ProductTopping[]
  orderItems OrderItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  imageUrl   String?
}

model ProductSize {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  recipe    ProductRecipe[]

  @@unique([productId, name])
}

model Ingredient {
  id            String          @id @default(cuid())
  name          String          @unique
  unit          IngredientUnit
  stockQuantity Int             @default(0)
  stockVersion  Int             @default(0)
  recipes       ProductRecipe[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ProductRecipe {
  id            String      @id @default(cuid())
  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  quantity      Int

  @@unique([productSizeId, ingredientId])
  @@index([ingredientId])
}

model ProductTopping {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  price     Int

  @@unique([productId, name])
}

model Order {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  subtotal       Int
  discountAmount Int         @default(0)
  total          Int
  couponCode     String?
  items          OrderItem[]
  payment        Payment?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  name          String
  sizeName      String?
  sizePrice     Int     @default(0)
  toppingsPrice Int     @default(0)
  toppings      Json    @default("[]")
  ingredients   Json    @default("[]")
  unitPrice     Int
  quantity      Int
  lineTotal     Int
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id])
  idempotencyKey String        @unique
  method         PaymentMethod
  amount         Int
  status         String        @default("SUCCEEDED")
  createdAt      DateTime      @default(now())
}

model Coupon {
  id                 String             @id @default(cuid())
  code               String             @unique
  discountType       DiscountType
  value              Int
  minimumOrderAmount Int                @default(0)
  maximumDiscount    Int?
  activeFrom         DateTime?
  activeUntil        DateTime?
  redemptions        CouponRedemption[]
  createdAt          DateTime           @default(now())
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @unique
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}
