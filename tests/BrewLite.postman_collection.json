                "type": "text/javascript",
                "exec": [
                  "pm.test('barista login succeeds', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (pm.response.code !== 201 || !body.accessToken || !body.user?.id) {",
