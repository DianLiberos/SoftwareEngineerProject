    {
      "name": "3. Payments & Idempotency Rules (Task 10b)",
      "item": [
        {
          "name": "Reject payment without Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{paidOrderId}}\",\n  \"method\": \"WALLET\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing idempotency header is rejected', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Pay pending order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{paymentKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{paidOrderId}}\",\n  \"method\": \"WALLET\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('payment succeeds', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('payment and related order are paid', () => {",
                  "  pm.expect(body.orderId).to.eql(pm.collectionVariables.get('paidOrderId'));",
                  "  pm.expect(body.amount).to.eql(Number(pm.collectionVariables.get('paidOrderTotal')));",
