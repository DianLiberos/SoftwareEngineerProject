        {
          "name": "7f. GET /orders/me - Lịch sử đơn của khách thể hiện COMPLETED",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/me",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order history contains completed order', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const list = pm.response.json();",
                  "    pm.expect(Array.isArray(list)).to.be.true;",
                  "    const targetOrder = list.find(o => o.id === pm.collectionVariables.get('orderE2EId'));",
                  "    pm.expect(targetOrder).to.not.be.undefined;",
                  "    pm.expect(targetOrder.status).to.eql('COMPLETED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
