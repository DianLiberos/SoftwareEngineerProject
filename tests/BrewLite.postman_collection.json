                  "    pm.collectionVariables.set('orderToCancelId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6c. PATCH /orders/:id/cancel - Hủy đơn hàng",
          "request": {
            "method": "PATCH",
