    {
      "name": "3. Integration - Tạo đơn & Trừ tồn kho nguyên liệu",
      "item": [
        {
          "name": "3a. GET /products/:id - Lấy tồn kho ban đầu (Initial Stock)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Get product succeeds (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.stock).to.be.a('number');",
                  "pm.collectionVariables.set('initialStock', json.stock.toString());"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3b. POST /orders - Tạo đơn hàng (1 ly M)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-demo-01\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 1,\n      \"sizeName\": \"M\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order creation succeeds (201 Created)', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.id).to.be.a('string');",
                  "pm.expect(json.status).to.eql('PENDING');",
                  "pm.collectionVariables.set('orderId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3c. GET /products/:id - Kiểm tra tồn kho suy diễn giảm đúng 1 ly",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Derived stock is decremented by exactly 1 item', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    const initialStock = Number(pm.collectionVariables.get('initialStock'));",
                  "    pm.expect(json.stock).to.eql(initialStock - 1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Task 10b - Idempotency Payment",
      "item": [
        {
          "name": "4a. POST /payments - Lần 1 (Tạo thanh toán thành công)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const key = 'postman-idemp-' + Date.now() + '-' + Math.floor(Math.random() * 10000);",
                  "pm.collectionVariables.set('idempotencyKey', key);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('First payment request succeeds (200/201)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.expect(json.status).to.eql('SUCCEEDED');",
                  "pm.expect(json.id).to.be.a('string');",
                  "pm.collectionVariables.set('paymentId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"method\": \"WALLET\",\n  \"simulateFailure\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          }
        },
        {
          "name": "4b. POST /payments - Lần 2 (Gửi lại cùng Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"method\": \"WALLET\",\n  \"simulateFailure\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": ["{{baseUrl}}"],
              "path": ["payments"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Second payment with identical Idempotency-Key returns existing payment', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get('paymentId'));",
                  "    pm.expect(json.status).to.eql('SUCCEEDED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Task 10a - Order State Machine Rules",
      "item": [
        {
          "name": "5. PATCH /orders/:id/status - Chặn nhảy cóc trạng thái (PAID -> COMPLETED)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{baristaToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderId}}", "status"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Illegal state transition (skipping steps) is blocked with 400 or 409', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Hủy đơn & Hoàn trả tồn kho nguyên liệu",
      "item": [
