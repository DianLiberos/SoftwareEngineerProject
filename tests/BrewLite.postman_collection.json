              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Test hủy đơn hoàn kho nguyên liệu qua Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderToCancelId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "{{orderToCancelId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Order cancelled successfully (200 OK)', function () {",
                  "    pm.response.to.have.status(200);",
