              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('coupon validates', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('coupon is valid and discounts the amount', () => {",
                  "  pm.expect(body.valid).to.eql(true);",
                  "  pm.expect(body.code).to.eql('BREW10');",
                  "  pm.expect(body.discountAmount).to.be.greaterThan(0);",
                  "  pm.expect(body.finalTotal).to.be.lessThan(100000);",
                  "});"
                ]
              }
            }
