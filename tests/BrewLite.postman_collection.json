                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"qty\": 2,\n      \"size\": {\n        \"name\": \"{{sizeName}}\",\n        \"price\": 999999\n      },\n      \"toppings\": []\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order is created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('order begins pending and uses database price', () => {",
                  "  pm.expect(body.status).to.eql('PENDING');",
                  "  pm.expect(body.total).to.eql(70000);",
                  "  pm.expect(body.items[0].quantity).to.eql(2);",
                  "  pm.expect(body.items[0].ingredients).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.items[0].ingredients.some((ingredient) => ingredient.name === 'Coffee')).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('paidOrderId', body.id);",
                  "pm.collectionVariables.set('paidOrderTotal', String(body.total));",
                  "pm.collectionVariables.set('paymentKey', `postman-payment-${body.id}`);",
                  "pm.collectionVariables.set('expectedPoints', String(Math.floor(body.total / 10000)));"
                ]
              }
            }
          ],
          "response": []
        },
