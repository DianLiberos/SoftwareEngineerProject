# BrewLite Monorepo - Root Environment Variables Template (.env.example)

# 1. PostgreSQL Database Configuration 
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
DATABASE_PORT=5432
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public

# 2. Backend API Service Configuration (apps/api - NestJS)
API_PORT=3001
JWT_SECRET=brewlite-super-secret-jwt-key-2026-development

# 3. Frontend Web Service Configuration (apps/web - Next.js 16)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
