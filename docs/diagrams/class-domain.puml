@startuml class-domain
title Sơ Đồ Lớp Miền Dữ Liệu Thực Thể (Domain Class Diagram - BrewLite)

skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI", Arial, sans-serif
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #F8F9FA
  BorderColor #343A40
  ArrowColor #212529
}

enum Role {
  CUSTOMER
  BARISTA
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  WALLET
  BANK_CARD
}

class User {
  +String id
  +String email
  +String passwordHash
  +String name
  +Role role
  +Int loyaltyPoints
  +DateTime createdAt
  +DateTime updatedAt
  --
  +createOrder()
  +redeemCoupon()
}

class Product {
  +String id
  +String name
  +String description
  +Decimal basePrice
  +Int stock
  +String imageUrl
  +Boolean isActive
  +DateTime createdAt
  +DateTime updatedAt
  --
  +checkAvailability(qty: Int): Boolean
  +decrementStock(qty: Int)
}

class ProductSize {
  +String id
  +String productId
  +String name
  +Decimal priceAdjustment
}

class ProductTopping {
  +String id
  +String productId
  +String name
  +Decimal priceAdjustment
}

class Order {
  +String id
  +String userId
  +OrderStatus status
  +Decimal totalAmount
  +Decimal discountAmount
  +Decimal finalAmount
  +String couponId
  +DateTime createdAt
  +DateTime updatedAt
  --
  +calculateTotal()
  +updateStatus(newStatus: OrderStatus)
}

class OrderItem {
  +String id
  +String orderId
  +String productId
  +String sizeName
  +String selectedToppings
  +Int quantity
  +Decimal unitPrice
  +Decimal subtotal
}

class Payment {
  +String id
  +String orderId
  +PaymentMethod method
  +Decimal amount
  +String idempotencyKey
  +String status
  +DateTime createdAt
}

class Coupon {
  +String id
  +String code
  +Decimal discountPercent
  +Decimal maxDiscount
  +Decimal minOrderValue
  +DateTime startDate
  +DateTime endDate
  +Boolean isActive
  --
  +isValid(orderTotal: Decimal): Boolean
}

class CouponRedemption {
  +String id
  +String couponId
  +String userId
  +String orderId
  +DateTime redeemedAt
}

' Quan hệ kết nối giữa các thực thể
User "1" *-- "0..*" Order : "khởi tạo"
User "1" *-- "0..*" CouponRedemption : "thực hiện đổi"

Product "1" *-- "1..*" ProductSize : "chứa các size"
Product "1" *-- "0..*" ProductTopping : "cho phép topping"
Product "1" <-- "0..*" OrderItem : "tham chiếu món"

Order "1" *-- "1..*" OrderItem : "bao gồm chi tiết"
Order "1" o-- "0..1" Payment : "được thanh toán bởi"
Order "0..1" <-- "0..1" CouponRedemption : "áp dụng ưu đãi"

Coupon "1" *-- "0..*" CouponRedemption : "ghi nhận lượt dùng"
Coupon "1" <-- "0..*" Order : "liên kết giảm giá"

User ..> Role
Order ..> OrderStatus
Payment ..> PaymentMethod

@enduml